# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Public site URL for canonical links, the sitemap and share previews (no trailing slash).
# On Vercel this defaults to the production *.vercel.app address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API. The publishable (anon) key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show "Continue with Google" on the sign-in page (needs the Google provider enabled in Supabase).
NEXT_PUBLIC_AUTH_GOOGLE=false

# FastAPI model server. Server-side only: the browser reaches it through /api/ai.
MODEL_SERVER_URL=http://localhost:8000

# true = answer AI calls from packages/core/fixtures until the model server is live.
NEXT_PUBLIC_API_FIXTURES=true

# Umami analytics (optional, free). Leave the website ID empty to disable.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
