{
  "name": "shevent",
  "private": true,
  "description": "Shevent: Lahore event marketplace (NETSOL AI/ML capstone)",
  "scripts": {
    "dev": "pnpm --filter @shevent/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:push": "supabase db push",
    "gen:types": "pnpm gen:types:api && pnpm gen:types:db",
    "gen:types:api": "openapi-typescript http://localhost:8000/openapi.json -o packages/core/types/openapi.d.ts",
    "gen:types:db": "supabase gen types typescript --local > packages/core/types/supabase.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "supabase": "2.121.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
