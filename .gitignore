# Private outreach contacts: never commit
private_contacts*.csv
!data/templates/private_contacts.csv

# Collected data and images stay out of git (shared via Google Drive)
data/raw/*
!data/raw/.gitkeep
data/images/
data/processed/
# Research workbooks hold public phone numbers and addresses: they never go in git. Convert them into data/raw.
data/*.xlsx

# Markdown docs, plans, slides and PDFs stay local
*.md
# ...except the submission docs: evaluation report, data card and model cards
!docs/evaluation_report.md
!docs/data_card.md
!docs/demo_script.md
!docs/setup.md
!.github/README.md
!docs/model_cards/
!docs/model_cards/*.md
*.pdf
*.ppt
*.pptx

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
# Local MLflow file stores (the Docker server keeps its data in a volume)
mlruns/
mlartifacts/
# ml/artifacts/ is tracked on purpose: the model server image needs the trained models (3 MB)

# Node / web
node_modules/
.next/
.vercel/
coverage/
*.tsbuildinfo
.env*.local


# Test reports: keep the Markdown, not the generated HTML/JSON
testing/reports/*.html
testing/reports/*.json

# Post-event feedback the model server collects for retraining
data/feedback/

# Collected vendors for the app database (python -m shevent_ml.data.app_seed)
supabase/seeds/collected_*.sql
