# Private outreach contacts: never commit
private_contacts*.csv
!data/templates/private_contacts.csv

# Collected data and images stay out of git (shared via Google Drive)
data/raw/*
!data/raw/.gitkeep
data/images/
data/processed/

# Markdown docs, plans, slides and PDFs stay local
*.md
*.pdf
*.ppt
*.pptx

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
# Local MLflow file stores (the Docker server keeps its data in a volume)
mlruns/
mlartifacts/
ml/artifacts/

# Node / web
node_modules/
.next/
.vercel/
coverage/
*.tsbuildinfo
.env*.local


# Test reports: keep the Markdown, not the generated HTML/JSON
testing/reports/*.html
testing/reports/*.json
