# Model server settings. Copy to server/.env.local (git-ignored) and start with
#   uvicorn app.main:app --app-dir server --env-file server/.env.local
# or set them in the host's environment.

# The app database the vendors are read from: the project URL and its publishable (anon) key. Vendors, review stats
# and sponsored placements are public under RLS, so no secret key is needed. Local Supabase: http://127.0.0.1:54321
# and the publishable key from `supabase status`. Leave both unset to rank the demo vendors in packages/core/fixtures.
SUPABASE_URL=
SUPABASE_KEY=
# How long the vendor list is kept before it is read again, in seconds.
CATALOG_TTL_SECONDS=300

# Browser origins allowed to call the server directly (comma-separated). The web app calls it from its own backend
# and the phone app isn't a browser, so this is usually empty.
ALLOWED_ORIGINS=

# Where post-event feedback is appended (default data/feedback/feedback.jsonl).
FEEDBACK_PATH=

# Vendors' listed prices (default data/processed/prices.parquet, from python -m shevent_ml.data.build). Matched to the
# collected vendors loaded by python -m shevent_ml.data.app_seed. Without it every price is #2's estimate.
PRICES_PATH=
