# Model server settings. Copy to server/.env.local (git-ignored) and start with
#   uvicorn app.main:app --app-dir server --env-file server/.env.local
# or set them in the host's environment.

# The app database the vendors are read from: the project URL and its publishable (anon) key. Vendors, review stats
# and sponsored placements are public under RLS, so no secret key is needed. Local Supabase: http://127.0.0.1:54321
# and the publishable key from `supabase status`. Leave both unset to rank the demo vendors in packages/core/fixtures.
SUPABASE_URL=
SUPABASE_KEY=
# How long the vendor list is kept before it is read again, in seconds.
CATALOG_TTL_SECONDS=300

# Browser origins allowed to call the server directly (comma-separated). The web app calls it from its own backend
# and the phone app isn't a browser, so this is usually empty.
ALLOWED_ORIGINS=

# Where post-event feedback is appended (default data/feedback/feedback.jsonl).
FEEDBACK_PATH=

# Vendors' listed prices (default data/processed/prices.parquet, from python -m shevent_ml.data.build). Matched to the
# collected vendors loaded by python -m shevent_ml.data.app_seed. Without it every price is #2's estimate.
PRICES_PATH=

# #8 Planning Assistant: a local Ollama (ollama pull qwen2.5:3b-instruct). OLLAMA_MODEL= (empty) turns the assistant
# off; its endpoint then answers 503 and the web app offers the planner form. The timeout is per model call.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=90
# How long Ollama keeps the model loaded after a call (-1: always). The server also loads it at startup.
OLLAMA_KEEP_ALIVE=30m
# 0 (default): the reply is a fixed sentence built from #1 and #2's results, so every claim in it is true.
# 1: the model words the reply and the output checker vets every figure; in the evaluation the 3B model still made
# false claims with true figures, so this is for trying larger models (eval: --llm-replies).
ASSISTANT_LLM_REPLIES=0

# #7 Verified Portfolios (/v1/portfolio/check): the collected photos' index and CLIP embeddings
# (python -m shevent_ml.images.build, default data/processed/image_index.parquet) and the CLIP model from the local
# Hugging Face cache (no internet at startup; set HF_HUB_OFFLINE=0 once to download it). Loading CLIP adds ~15 s and
# ~600 MB; PORTFOLIO_CHECK=0 skips it and the endpoint answers 503.
PORTFOLIO_CHECK=1
IMAGE_INDEX_PATH=
